SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./nomly.db
CORS_ORIGINS=http://localhost:3000
# Seeds demo data automatically on startup if the DB is empty -- keep true in
# production so hosting platforms with ephemeral disks always boot with data.
AUTO_SEED_ON_STARTUP=true
